# Copy to .env (never commit .env). No real values are included here.

# Public domain of this customer's installation (DNS A record must point to the VPS)
DOMAIN=billing.example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL (used by the db container; choose a long random password)
POSTGRES_DB=hardware_billing
POSTGRES_USER=hardware
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# Optional: fixed one-time token for first-time administrator setup.
# Leave empty to let the app generate a random token and print it once in `docker compose logs app`.
SETUP_TOKEN=

# Optional JVM tuning
JAVA_OPTS=-XX:MaxRAMPercentage=75
